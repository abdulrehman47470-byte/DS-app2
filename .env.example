# Daily Stogie environment variables.
# Copy this file to .env and fill in values. With everything blank the app runs on mock data.

# Supabase (Phase 1) - Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe test mode (Phase 6) - Developers > API keys (publishable key only in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=

# Mapbox (Phase 7) - account.mapbox.com > Access tokens
VITE_MAPBOX_TOKEN=

# Verification provider: mock | free-face-check | persona | veriff
VITE_VERIFICATION_PROVIDER=mock
